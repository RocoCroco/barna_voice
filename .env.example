# Docker Compose configuration. Copy to .env; never commit filled-in credentials.
SLNG_API_KEY=
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Local HTTP. For public HTTPS use your domain, HTTP_PORT=80, HTTPS_PORT=443.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
IMAGE_TAG=local

# Seeds only an empty database; persisted history is never replaced.
SEED_DEMO_DATA=true

# Set a TURN service for reliable media across NAT/firewalls (see DEPLOYMENT.md).
PIPECAT_ICE_SERVERS=stun:stun.l.google.com:19302
